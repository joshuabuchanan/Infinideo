# Required app configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Required server-side credentials
DATABASE_URL=
CLERK_WEBHOOK_SIGNING_SECRET=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
UPLOADTHING_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL; use the deployed HTTPS origin in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: required only for YouTube API integration
YOUTUBE_API_KEY=

# Optional: official Twitch clips integration (server-side app credentials)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: Pexels video search (server-side API key)
PEXELS_API_KEY=

# Optional: Pixabay video search (server-side API key)
PIXABAY_API_KEY=

# Optional: NASA public media integration
NASA_API_KEY=
NASA_BASE_URL=https://images-assets.nasa.gov

# Optional: Wikimedia Commons public API (usually no key required)
WIKIMEDIA_API_BASE_URL=https://commons.wikimedia.org/w/api.php

# Optional: Internet Archive public API
INTERNET_ARCHIVE_API_BASE_URL=https://archive.org/advancedsearch.php

# Optional: PeerTube public instance
PEERTUBE_INSTANCE_URL=https://peertube.tv

# Optional: blender/open movie metadata via official archive feeds
BLENDER_BASE_URL=https://archive.org/details

# Optional cache / app configuration
